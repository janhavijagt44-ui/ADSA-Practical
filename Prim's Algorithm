graph = [
    [0, 2, 3, 0],
    [2, 0, 1, 4],
    [3, 1, 0, 5],
    [0, 4, 5, 0]
]

n = len(graph)
selected = [False] * n
selected[0] = True

total = 0

for i in range(n - 1):
    minimum = 999
    x = 0
    y = 0

    for j in range(n):
        if selected[j]:
            for k in range(n):
                if not selected[k] and graph[j][k] != 0:
                    if graph[j][k] < minimum:
                        minimum = graph[j][k]
                        x = j
                        y = k

    print(x, "--", y, "=", minimum)
    total += minimum
    selected[y] = True

print("Minimum cost:", total)
