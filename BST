class Node:
    def __init__(self, key):
        self.key = key
        self.left = None
        self.right = None

def search(node, key):
    if node is None:
        return False
    if node.key == key:
        return True
    if key < node.key:
        return search(node.left, key)
    else:
        return search(node.right, key)

root = Node(50)
root.left = Node(30)
root.right = Node(70)
root.left.left = Node(20)
root.left.right = Node(40)
root.right.left = Node(60)
root.right.right = Node(80)

key = 60

if search(root, key):
    print("Key found")
else:
    print("Key not found")
